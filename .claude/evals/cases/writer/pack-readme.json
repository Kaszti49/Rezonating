{
  "description": "Writes code docs without vault references",
  "prompt": "Write packs/README.md: what a pack is, what pack.json contains (read schemas/pack-manifest.schema.json and the three packs), and how to validate one. Under 40 lines.",
  "max_turns": 15,
  "allowed_tools": [
    "Read",
    "Edit",
    "Write",
    "Glob",
    "Grep"
  ],
  "checks": [
    {
      "type": "file_exists",
      "path": "packs/README.md"
    },
    {
      "type": "file_contains",
      "path": "packs/README.md",
      "pattern": "tools/validate\\.py"
    },
    {
      "type": "file_not_contains",
      "path": "packs/README.md",
      "pattern": "\\[\\[|90 Meta|00 Inbox|Obsidian"
    },
    {
      "type": "changed_only",
      "paths": [
        "packs/README.md"
      ]
    }
  ]
}
