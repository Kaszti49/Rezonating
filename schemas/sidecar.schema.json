{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rezonating.com/schemas/sidecar/v1",
  "title": "Rezonating recording sidecar",
  "description": "JSON file next to every WAV recording (same base name). Describes setup, sample accounting and labels. v1 (D-019); v0 files stay valid. Tier 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session", "node", "firmware", "start_utc", "sample_rate", "channels", "protocol"],
  "properties": {
    "schema": { "enum": [0, 1] },
    "session": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}_[a-z0-9-]+_[a-z0-9-]+_\\d{2}$",
      "description": "YYYY-MM-DD_<site>_<room>_<nn>"
    },
    "node": { "type": "string" },
    "firmware": { "type": "string" },
    "start_utc": { "type": "string", "format": "date-time" },
    "sample_rate": {
      "type": "integer",
      "minimum": 1,
      "description": "Rate in the WAV header. v1: round(sample_rate_measured)."
    },
    "sample_rate_nominal": { "type": "integer", "minimum": 1, "description": "v1: rate the node was set to, e.g. 2000." },
    "sample_rate_measured": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "v1: measured rate in Hz (DRDY counted against the ESP32 timer), e.g. 2016.13."
    },
    "stream": { "enum": ["adc_raw", "adc_dec", "accel"], "description": "v1: node stream in this WAV (D-018, D-020)." },
    "clock": { "enum": ["ltc6903", "adxl355", "crystal"], "description": "v1: what clocks the samples." },
    "first_sample": { "type": "integer", "minimum": 0, "description": "v1: node sample index of the WAV's first frame." },
    "t_dev_us": { "type": "integer", "minimum": 0, "description": "v1: node microsecond clock at the first frame." },
    "loss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "link", "host"],
      "description": "v1: samples lost in acquisition, in the node's send queue, and as gaps seen on the PC. Missing samples are zeros in the WAV.",
      "properties": {
        "device": { "type": "integer", "minimum": 0 },
        "link": { "type": "integer", "minimum": 0 },
        "host": { "type": "integer", "minimum": 0 }
      }
    },
    "link": { "enum": ["usb", "wifi", "sd"], "description": "v1: how the samples reached the PC." },
    "kind": { "enum": ["continuous", "event"], "default": "continuous" },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ch", "head", "serial", "units"],
        "properties": {
          "ch": { "type": "integer", "minimum": 0, "maximum": 7 },
          "port": { "type": "integer", "minimum": 1, "maximum": 4 },
          "head": { "type": "string", "examples": ["geophone/sm24"] },
          "serial": { "type": "string" },
          "units": { "enum": ["m/s", "g", "V", "counts"] },
          "scale": { "type": "number", "description": "Multiply raw counts by this to get units." },
          "gain": { "enum": [1, 2, 4, 8, 16, 32, 64, 128] },
          "mount": { "type": "string" },
          "surface": { "type": "string", "examples": ["laminate on concrete slab"] },
          "position_m": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 }
        }
      }
    },
    "protocol": { "type": "string", "examples": ["walk-pass-v1"] },
    "notes": { "type": "string" },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t0", "t1", "label"],
        "properties": {
          "t0": { "type": "number", "minimum": 0, "description": "Seconds from the WAV start = i0 / sample_rate." },
          "t1": { "type": "number", "minimum": 0 },
          "i0": { "type": "integer", "minimum": 0, "description": "v1: start as a sample index within this WAV." },
          "i1": { "type": "integer", "minimum": 0 },
          "src": { "enum": ["key", "phone", "review", "auto"], "description": "v1: where the mark came from." },
          "unc_ms": { "type": "number", "minimum": 0, "description": "v1: timing uncertainty of a live mark." },
          "label": { "type": "string" },
          "person": { "type": "string", "pattern": "^P\\d+$", "description": "Pseudonym only, never a name." },
          "shoes": { "type": "boolean" },
          "pace": { "enum": ["slow", "normal", "fast"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema": { "const": 1 } } },
      "then": {
        "required": ["sample_rate_nominal", "sample_rate_measured", "stream", "clock", "first_sample", "t_dev_us", "loss", "link"],
        "properties": { "labels": { "items": { "required": ["i0", "i1", "src"] } } }
      }
    },
    {
      "if": { "properties": { "stream": { "const": "accel" } }, "required": ["stream"] },
      "then": { "properties": { "clock": { "const": "adxl355" } } }
    },
    {
      "if": { "properties": { "stream": { "enum": ["adc_raw", "adc_dec"] } }, "required": ["stream"] },
      "then": { "properties": { "clock": { "enum": ["ltc6903", "crystal"] } } }
    },
    {
      "if": { "properties": { "schema": { "const": 0 } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["sample_rate_nominal"] },
            { "required": ["sample_rate_measured"] },
            { "required": ["stream"] },
            { "required": ["clock"] },
            { "required": ["first_sample"] },
            { "required": ["t_dev_us"] },
            { "required": ["loss"] },
            { "required": ["link"] }
          ]
        }
      }
    }
  ]
}
